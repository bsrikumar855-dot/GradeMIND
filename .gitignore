# Root-anchored artefacts.
#
# The rules below are anchored to backend/, but tooling run from the repo root
# writes to root-relative paths — backend/e2e_qa_test.py used
# Path("storage/test_answer_sheet.png"), which lands at ./storage/ and matches
# none of them. Both files reached the index that way.
# See docs/audit/BASELINE_AUDIT.md N2.
/storage/
/e2e_results.json
/tmp/

# Storage (keep directory markers, ignore actual uploaded content)
backend/storage/*
!backend/storage/answer_keys/
!backend/storage/answer_sheets/
backend/storage/answer_keys/*
backend/storage/answer_sheets/*
!backend/storage/answer_keys/.gitkeep
!backend/storage/answer_sheets/.gitkeep

# Generated reports
AI/tests/test_pipeline_output.json

# OS and misc
Thumbs.db
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*
.env*.local
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Evaluation data: real student work. Never enters this repo.
# See docs/eval/ and the harness precondition in scripts/eval_metrics.py.
/eval_data/
/eval_results/
