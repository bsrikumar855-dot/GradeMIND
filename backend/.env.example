# Database Configuration
DATABASE_URL=postgresql://username:password@localhost/grademind

# Security
SECRET_KEY=YOUR_SECRET_KEY

# Application Settings
DEBUG=True
AUTH_ENABLED=false
PROJECT_NAME="GradeMIND Backend"
PROJECT_VERSION="1.0.0"

# Gemini API Configuration (optional).
# Grading works fully with zero API keys via the local autonomous evaluator;
# setting this only enables an additional Gemini-based cross-check score.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
