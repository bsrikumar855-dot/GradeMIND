# Database Configuration
DATABASE_URL=postgresql://username:password@localhost/grademind

# Security
SECRET_KEY=YOUR_SECRET_KEY

# Application Settings
DEBUG=True
# Secure by default. Only set to false for a local no-login demo (every
# request is then treated as an anonymous admin) — never in a shared/real
# deployment.
# local | ci | staging | production. Defaults to production when unset, so a
# forgotten value is never the one that permits the auth bypass.
ENVIRONMENT=local

# Disabling auth requires ALL THREE of AUTH_ENABLED=false, DEBUG=True and
# ENVIRONMENT=local simultaneously. Any other combination makes the process
# refuse to start, because with auth disabled every request is served as an
# anonymous ADMIN.
AUTH_ENABLED=true
PROJECT_NAME="GradeMIND Backend"
PROJECT_VERSION="1.0.0"

# Gemini API Configuration (optional).
# Grading works fully with zero API keys via the local autonomous evaluator;
# setting this only enables an additional Gemini-based cross-check score.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
