# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the resulting .env file.

# --- Postgres (db service) ---
POSTGRES_USER=grademind
# Required. Use a strong, unique password — docker-compose will refuse to
# start without it.
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_DB=grademind

# --- Backend (FastAPI) ---
# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_random_secret

# Must be False in any real/shared deployment.
DEBUG=False

# Must be True in any non-demo deployment. Only set to False for local demo
# mode (no login/auth enforcement) as described in the project README.
# local | ci | staging | production. Defaults to production when unset.
ENVIRONMENT=production

# Disabling auth requires AUTH_ENABLED=False + DEBUG=True + ENVIRONMENT=local,
# all three at once. Anything else and the process refuses to start.
AUTH_ENABLED=True

# Optional. Grading works fully with zero API keys via the local autonomous
# evaluator; setting this only enables an additional Gemini cross-check score.
GEMINI_API_KEY=your_gemini_api_key_here

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
